#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh_1" (
        prepend references = @../../geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1"
        {
            over "subset_" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/plastic_>
            }

            over "color" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/plastic_>
            }

            over "paint" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/paint>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "plastic_" (
                instanceable = true
                delete references = @../../materials.usda@</Materials/plastic_>
                prepend references = @../../materials.usda@</Materials/white>
            )
            {
            }

            def Material "paint" (
                instanceable = true
                prepend references = @../../materials.usda@</Materials/paint>
            )
            {
            }
        }
    }
}
