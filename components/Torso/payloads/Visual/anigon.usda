#usda 1.0
(
    defaultPrim = "Torso"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Torso"
{
    over "stand_link3"
    {
        over "visuals"
        {
            over "neck2" (
                references = @./instances/anigon.usda@</Instances/mesh>
            )
            {
            }

            over "torso" (
                references = @./instances/anigon.usda@</Instances/mesh_1>
            )
            {
            }

            over "button" (
                references = @./instances/anigon.usda@</Instances/mesh_2>
            )
            {
            }
        }
    }
}
