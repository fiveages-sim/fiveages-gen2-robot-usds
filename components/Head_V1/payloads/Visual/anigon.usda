#usda 1.0
(
    defaultPrim = "Head_V1"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Head_V1"
{
    over "head_link1"
    {
        over "visuals"
        {
            over "head_yaw" (
                references = @./instances/anigon.usda@</Instances/mesh>
            )
            {
            }
        }
    }

    over "head_link2"
    {
        over "visuals"
        {
            over "head_pitch" (
                references = @./instances/anigon.usda@</Instances/mesh_1_1>
            )
            {
            }

            over "neck" (
                references = @./instances/anigon.usda@</Instances/mesh_2>
            )
            {
            }
        }
    }
}
