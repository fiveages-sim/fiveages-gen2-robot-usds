#usda 1.0
(
    defaultPrim = "FiveAges_S2"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FiveAges_S2"
{
    over "stand_link3"
    {
        def "Torso" (
            prepend payload = @../../../components/Torso/Torso.usda@
            variants = {
                string Robot = "none"
                string visual = "default"
            }
        )
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "root_joint" (
                active = false
            )
            {
            }

            over "stand_link3"
            {
                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </FiveAges_S2/stand_link3>
                    rel physics:body1 = </FiveAges_S2/stand_link3/Torso/stand_link3>
                    point3f physics:localPos0 = (0, 0, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }
}
