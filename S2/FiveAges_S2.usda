def Xform "FiveAges_S2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Arm_Left = "M6_CCS"
        string Arm_Right = "M6_CCS"
        string Head = "v1"
        string Physics = "physx"
        string ROS = "none"
        string Robot = "none"
        string Sensor = "none"
        string Torso = "default"
        string Visual = "default"
    }
    prepend variantSets = ["Physics", "Visual", "Torso", "Head", "Arm_Left", "Arm_Right", "ROS"]
    append variantSets = ["Robot", "Sensor"]
)
{
    string isaac:description = "FiveAges S2 Column Humanoid"
    token isaac:license = "Apache-2.0"
    string isaac:namespace = ""
    token isaac:robotType = "Manipulators"
    string isaac:version = ""

    over "base_footprint"
    {
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001

        over "base_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }
    }

    over "joints"
    {
        over "lift_joint"
        {
            float state:linear:physics:position = 0
            float state:linear:physics:velocity = 0
        }

        over "body_joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "body_joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }

    over "Head_V1"
    {
        over "joints"
        {
            over "head_joint1"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "head_joint2"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }
    }

    over "root_joint"
    {
        bool[] isaac:actuator (
            displayName = "Actuator"
        )
        string isaac:NameOverride (
            displayName = "Joint Name Override"
        )
        token[] isaac:physics:DofOffsetOpOrder (
            displayName = "Dof Offset Op Order"
        )
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 5
        float physxArticulation:stabilizationThreshold = 0.00001
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "Visual" = {
        "anigon" (
            prepend payload = @./payloads/Visual/anigon.usda@
        ) {

        }
        "default" {

        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {

        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {

        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {

        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {

        }
    }
    variantSet "Torso" = {
        "None" {

        }
        "default" (
            prepend payload = @./payloads/Torso/default.usda@
        ) {

        }
    }
    variantSet "Head" = {
        "None" {

        }
        "v1" (
            prepend payload = @payloads/Head/v1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_S2/Head_V1>
            prepend rel isaac:physics:robotLinks = </FiveAges_S2/Head_V1>

        }
    }
    variantSet "Arm_Left" = {
        "AR5_CCS_V2" (
            prepend payload = @payloads/Arm_Left/AR5_CCS_V2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_S2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_S2/Left_Arm>

        }
        "ART7" (
            prepend payload = @payloads/Arm_Left/ART7.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_S2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_S2/Left_Arm>

        }
        "M6_CCS" (
            prepend payload = @payloads/Arm_Left/M6_CCS.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_S2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_S2/Left_Arm>

        }
        "None" {

        }
    }
    variantSet "Arm_Right" = {
        "AR5_CCS_V2" (
            prepend payload = @payloads/Arm_Right/AR5_CCS_V2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_S2/Right_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_S2/Right_Arm>

