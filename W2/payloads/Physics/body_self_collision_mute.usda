#usda 1.0
(
    doc = """W2 NonDexHand mute — subLayer of payloads/Physics/physx.usda ONLY.

PhysX: CollisionGroup + filteredGroups self-filter. Always composed with
Physics=physx (any Arm_Left/Arm_Right mix).

Nested M6 also authors CollisionGroups/NonDexHand on the same arm links.
A collider may belong to only ONE PhysX group — dual membership spams
  [omni.physx.plugin] Collisions are supported currently only in one collision group
especially for gripper/EE colliders (not in the dexhand excludes). Deactivate
the nested arm groups so body/chassis/arm/gripper live only in this parent
group. Dexhand roots stay excluded (ungrouped finger self-col).

Newton does NOT reliably honor filteredGroups / CollectionAPI membership;
see body_self_collision_mute_newton.usda — wired as append references on
FiveAges_W2 Physics=mujoco (body+chassis+Head; never Left/Right_Arm).
Payload subLayer mute is too weak vs base.usda (authored=False).

Keep hand prim names in sync with M6 EE dexhand_self_collision.usda.
Grippers are intentionally not excluded.
Head_V1 is included so head↔torso/body self-col is filtered (yaw was jammed).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "FiveAges_W2"
{
    def Scope "CollisionGroups"
    {
        def PhysicsCollisionGroup "NonDexHand" (
            prepend apiSchemas = ["CollectionAPI:colliders"]
        )
        {
            uniform token collection:colliders:expansionRule = "expandPrims"
            prepend rel collection:colliders:includes = [
                </FiveAges_W2/base_link>,
                </FiveAges_W2/body_link1>,
                </FiveAges_W2/body_link2>,
                </FiveAges_W2/body_link3>,
                </FiveAges_W2/body_link4>,
                </FiveAges_W2/Head_V1>,
                </FiveAges_W2/Linkhou_S2>,
                </FiveAges_W2/Left_Arm>,
                </FiveAges_W2/Right_Arm>,
            ]
            prepend rel collection:colliders:excludes = [
                </FiveAges_W2/Left_Arm/link7/tcp/LinkerHand_o6>,
                </FiveAges_W2/Left_Arm/link7/tcp/LinkerHand_o7>,
                </FiveAges_W2/Left_Arm/link7/tcp/L6>,
                </FiveAges_W2/Left_Arm/link7/tcp/Wuji_hand2>,
                </FiveAges_W2/Left_Arm/link7/tcp/Xhand1>,
                </FiveAges_W2/Right_Arm/link7/tcp/LinkerHand_o6>,
                </FiveAges_W2/Right_Arm/link7/tcp/LinkerHand_o7>,
                </FiveAges_W2/Right_Arm/link7/tcp/L6>,
                </FiveAges_W2/Right_Arm/link7/tcp/Wuji_hand2>,
                </FiveAges_W2/Right_Arm/link7/tcp/Xhand1>,
            ]
            prepend rel physics:filteredGroups = [
                </FiveAges_W2/CollisionGroups/NonDexHand>,
            ]
        }
    }

    over "Left_Arm"
    {
        over "CollisionGroups"
        {
            over "NonDexHand" (
                active = false
            )
            {
            }
        }
    }

    over "Right_Arm"
    {
        over "CollisionGroups"
        {
            over "NonDexHand" (
                active = false
            )
            {
            }
        }
    }
}
