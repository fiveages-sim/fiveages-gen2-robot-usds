#usda 1.0
(
    defaultPrim = "FiveAges_W2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@,
        @./body_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

def "FiveAges_W2"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        # On for any arm mix; NonDexHand (body_self_collision_mute.usda) mutes
        # torso/chassis/arm self-pairs. Dexhand EE excludes keep fingers free.
        bool physxArticulation:enabledSelfCollisions = 1
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }

    over "joints"
    {
        over "body_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "body_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "body_joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "body_joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }
    }

    over "Linkhou_S2" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "Head_V1" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "Left_Arm" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "Right_Arm" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "body_link4"
    {
        over "Torso" (
            variants = {
                string Physics = "physx"
            }
        )
        {
        }
    }
}

