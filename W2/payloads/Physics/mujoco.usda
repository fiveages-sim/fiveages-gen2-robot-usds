#usda 1.0
(
    defaultPrim = "FiveAges_W2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "FiveAges_W2"
{
    over "joints"
    {
        # PhysX DriveAPI (kp=5000, kd=500) -> MjcActuator position PD
        # F = kp*(ctrl - q) - kd*qdot
        over "body_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -500
            uniform double mjc:actuatorfrcrange:max = 500
        }

        over "body_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -500
            uniform double mjc:actuatorfrcrange:max = 500
        }

        over "body_joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -500
            uniform double mjc:actuatorfrcrange:max = 500
        }

        over "body_joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -500
            uniform double mjc:actuatorfrcrange:max = 500
        }
    }

    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        # NEWTON: self-col ON. Body/chassis/Head mute via W2 root Physics=mujoco
        # append-ref body_self_collision_mute_newton (collisionEnabled=0; no arm paths).
        # Arms: M6 arm_self_collision_mute_newton. PhysX: CollisionGroup NonDexHand.
        # Art root = base_link (unchanged). Do not swap mute to filteredPairs lightly.
        bool newton:selfCollisionEnabled = 1
    }


    over "body_link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link3"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link4"
    {
        uniform float mjc:gravcomp = 1

        over "Torso" (
            variants = {
                string Physics = "mujoco"
            }
        )
        {
        }
    }

    def Scope "actuators"
    {
        def MjcActuator "body_joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -500
            uniform double mjc:forceRange:max = 500
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -77.49999
            uniform double mjc:ctrlRange:max = 32.5
            rel mjc:target = </FiveAges_W2/joints/body_joint1>
        }

        def MjcActuator "body_joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -500
            uniform double mjc:forceRange:max = 500
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -152.40999
            uniform double mjc:ctrlRange:max = 91.96
            rel mjc:target = </FiveAges_W2/joints/body_joint2>
        }

        def MjcActuator "body_joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -500
            uniform double mjc:forceRange:max = 500
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -99.99999
            uniform double mjc:ctrlRange:max = 99.99999
            rel mjc:target = </FiveAges_W2/joints/body_joint3>
        }

        def MjcActuator "body_joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -500
            uniform double mjc:forceRange:max = 500
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -180
            uniform double mjc:ctrlRange:max = 180
            rel mjc:target = </FiveAges_W2/joints/body_joint4>
        }
    }

    over "Linkhou_S2" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }

    over "Head_V1" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }

    over "Left_Arm" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }

    over "Right_Arm" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }
}
