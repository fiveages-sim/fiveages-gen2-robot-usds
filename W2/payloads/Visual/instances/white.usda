#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh_2" (
        prepend references = @../../geometries.usd@</Geometries/mesh_2>
    )
    {
        over "mesh_2"
        {
            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_2/VisualMaterials/black>
            }

            over "color" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_2/VisualMaterials/plastic_>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @../../materials.usda@</Materials/black>
            )
            {
            }

            def Material "plastic_" (
                instanceable = true
                delete references = [
                    @../../materials.usda@</Materials/plastic_>,
                    @../../materials.usda@</Materials/color>
                ]
                prepend references = @../../materials.usda@</Materials/white>
            )
            {
            }
        }
    }
}
