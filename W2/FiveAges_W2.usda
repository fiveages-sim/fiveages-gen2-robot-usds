        "M6_CCS" (
            delete payload = @payloads/Arm_Left/base.usd@
            prepend payload = @payloads/Arm_Left/M6_CCS.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Left_Arm>

        }
        "None" {

        }
    }
    variantSet "Arm_Right" = {
        "AR5_CCS_V2" (
            prepend payload = @payloads/Arm_Right/AR5_CCS_V2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Right_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Right_Arm>

