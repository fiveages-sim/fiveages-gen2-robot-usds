def Xform "FiveAges_W2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Arm_Left = "M6_CCS"
        string Arm_Right = "M6_CCS"
        string Chassis = "LinkhouS2_V1"
        string Head = "v1"
        string Torso = "default"
        # No authored Physics default — VariantSwitcher selects physx/mujoco by engine.
        # Authored Physics=physx blocked Newton from loading mujoco mute layers.
        string ROS = "none"
        string Robot = "none"
        string Sensor = "none"
        string Visual = "default"
    }
    prepend variantSets = ["Physics", "Visual", "Torso", "Head", "Chassis", "Arm_Left", "Arm_Right", "ROS"]
    append variantSets = ["Robot", "Sensor"]
)
{
    string isaac:description = "FiveAges W2 Wheel Humanoid"
    token isaac:license = "Apache-2.0"
