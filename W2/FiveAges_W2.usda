                float state:angular:physics:velocity = 0
            }

            over "left_joint7"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
            # NEWTON NonDexHand mute (2026-09 validated):
            # append REFERENCE (not mujoco subLayer) so opinions beat base.usda.
            # File MUST NOT contain Left_Arm/Right_Arm — that races Arm payloads (Stage red).
            # Arms muted in M6 Physics=mujoco. PhysX still uses CollisionGroup.
            # Art root stays base_link. Diagnose: env/newton_verify_mute.py
            append references = @./payloads/Physics/body_self_collision_mute_newton.usda@</FiveAges_W2>
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "Visual" = {
        "anigon" (
            prepend payload = @./payloads/Visual/anigon.usda@
        ) {

        }
        "default" {

        }
        "white" (
            prepend payload = @./payloads/Visual/white.usda@
        ) {

        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {

        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {

        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {

        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {

        }
    }
    variantSet "Torso" = {
        "None" {

        }
        "default" (
            prepend payload = @./payloads/Torso/default.usda@
        ) {

        }
    }
    variantSet "Head" = {
        "None" {

        }
        "v1" (
            delete payload = @payloads/Head/base.usd@
            prepend payload = @payloads/Head/v1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Head_V1>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Head_V1>

        }
    }
    variantSet "Chassis" = {
        "LinkhouS2_V1" (
            prepend payload = @payloads/Chassis/LinkhouS2_V1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Linkhou_S2>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Linkhou_S2>

        }
        "LinkhouS2_V2" (
            prepend payload = @payloads/Chassis/LinkhouS2_V2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Linkhou_S2>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Linkhou_S2>

        }
        "None" {

        }
    }
    variantSet "Arm_Left" = {
        "AR5_CCS_V2" (
            prepend payload = @payloads/Arm_Left/AR5_CCS_V2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Left_Arm>

        }
        "ART7" (
            prepend payload = @payloads/Arm_Left/ART7.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </FiveAges_W2/Left_Arm>
            prepend rel isaac:physics:robotLinks = </FiveAges_W2/Left_Arm>

