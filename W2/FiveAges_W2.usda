        }

        over "Graph"
        {
            over "ROS_Steering_Controller"
            {
                # Must target art root base_link (DOF host). FiveAges_W2 Xform alone
                # can resolve inconsistently under Newton vs Chassis mount intent.
                over "articulation_controller"
                {
                    custom rel inputs:targetPrim = </FiveAges_W2/base_link>
                }

                over "articulation_controller_01"
                {
                    custom rel inputs:targetPrim = </FiveAges_W2/base_link>
                }
            }

            over "ROS_Odometry"
            {
                over "ComputeOdometry" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform float2 ui:nodegraph:node:pos = (-680.7657, 234.95526)
                }
            }
        }
    }

    over "Left_Arm"
    {
        over "base_link"
        {
        }

        over "link1"
        {
        }

        over "link2"
        {
        }

        over "link3"
        {
        }

        over "link4"
        {
