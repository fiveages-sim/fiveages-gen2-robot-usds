#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (2.8861678217954583, 1.105510629130843, 3.3238250055157375)
                double3 target = (0.3568642669972264, -0.15914140596778803, 1.0474515900616397)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./dexhand_o7_new.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = """Clean W2 + LinkerHand o7 grasp env.
Grid floor + official table/props + W2 variants + tcp orients.
PhysicsScene aligned with env/empty.usda (dual-track PhysX/Newton).
Do NOT hot-switch physics engine after opening — reopen stage after switch.
"""
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "default_environment" (
        prepend payload = @../../../../../../environment/fiveages_env/background/Grid/default_environment.usd@
    )
    {
        def "EastRural_Table" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
            prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/ArchVis/Residential/Furniture/DiningSets/EastRural/EastRural_Table.usd@
        )
        {
            bool physics:kinematicEnabled = 1
            bool physics:rigidBodyEnabled = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:scale:unitsResolve = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
            double3 xformOp:translate = (0.7809491800025677, -0.024510217142726755, 4.99174007018155e-7)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

            over "TableTop" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxTriangleMeshCollisionAPI"]
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float physics:dynamicFriction = 1.2
                float physics:restitution = 0
                float physics:staticFriction = 1.5
                float physxCollision:contactOffset = 0.002
                float physxCollision:restOffset = 0
                uniform token physxMaterial:frictionCombineMode = "max"
                bool physxMaterial:improvePatchFriction = 1
                uniform token physxMaterial:restitutionCombineMode = "min"
            }

            over "TableBase" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxTriangleMeshCollisionAPI"]
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float physics:dynamicFriction = 1.2
                float physics:restitution = 0
                float physics:staticFriction = 1.5
                uniform token physxMaterial:frictionCombineMode = "max"
                uniform token physxMaterial:restitutionCombineMode = "min"
            }

            def "sm_apple_a01_01" (
                prepend payload = @https://omniverse-content-staging.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/SimReady/Residential/Kitchen/Food/Fruit/Apple_A01/sm_apple_a01_01.usd@
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (100, 100, 100)
                double3 xformOp:translate = (-8.25796788271272, -2.828646396976677, 81.37314657617344)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def "NaturalBostonRoundBottle_A01_PR_NVD_01" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
                prepend payload = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Storage/Bottles/Plastic/NaturalBostonRound_A/NaturalBostonRoundBottle_A01_PR_NVD_01.usd@
            )
            {
                rel material:binding = </World/default_environment/EastRural_Table/NaturalBostonRoundBottle_A01_PR_NVD_01/PhysicsMaterial> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                bool physics:kinematicEnabled = 0
                float physics:mass = 0.25
                bool physics:rigidBodyEnabled = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (100, 100, 100)
                double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
                double3 xformOp:translate = (-16.891523777481382, -19.67202345466411, 76.2000019013874)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

                over "NaturalBostonRoundBottle_A01_01" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    rel material:binding = </World/default_environment/EastRural_Table/NaturalBostonRoundBottle_A01_PR_NVD_01/PhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                    float physics:dynamicFriction = 1.6
                    float physics:restitution = 0
                    float physics:staticFriction = 2
                    float physxCollision:contactOffset = 0.002
                    float physxCollision:restOffset = 0
                    uniform token physxMaterial:frictionCombineMode = "max"
                    bool physxMaterial:improvePatchFriction = 1
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "PhysicsMaterial" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 1.6
                    float physics:restitution = 0
                    float physics:staticFriction = 2
                    uniform token physxMaterial:frictionCombineMode = "max"
                    bool physxMaterial:improvePatchFriction = 1
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }
            }
        }
    }

    def "FiveAges_W2" (
        prepend payload = @../FiveAges_W2.usda@
        variants = {
            string ROS = "enable"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.18388290077871555, 0.09478332836271869, 0.07203023299171055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Linkhou_S2" (
            variants = {
                string ROS = "enable"
            }
        )
        {
        }

        over "Left_Arm" (
            variants = {
                string EE = "LinkerHand_o7"
            }
        )
        {
            over "link7"
            {
                over "tcp"
                {
                    string isaac:Description (
                        displayName = "Reference Description"
                    )
                    uniform token isaac:forwardAxis (
                        displayName = "Forward Axis"
                    )
                    quatd xformOp:orient = (0.5000000000000001, 0.5, -0.49999999999999994, 0.5)
                }
            }
        }

        over "Right_Arm" (
            variants = {
                string EE = "LinkerHand_o7"
            }
        )
        {
            over "link7"
            {
                over "tcp"
                {
                    string isaac:Description (
                        displayName = "Reference Description"
                    )
                    uniform token isaac:forwardAxis (
                        displayName = "Forward Axis"
                    )
                    quatd xformOp:orient = (0.5000000000000001, 0.5, 0.49999999999999994, -0.5)
                }
            }
        }

        over "Head_V1" (
            variants = {
                string ROS = "none"
                string Sensor = "sensors"
            }
        )
        {
        }
    }
}

def Xform "Environment"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:exposure = 1.5
        float inputs:intensity = 3000
        bool inputs:normalize = 1
        float inputs:shaping:cone:angle = 180
        quatd xformOp:orient = (0.6532814824381883, 0.2705980500730985, 0.27059805007309845, 0.6532814824381882)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

