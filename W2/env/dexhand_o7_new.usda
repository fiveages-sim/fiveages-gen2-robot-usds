def PhysicsScene "PhysicsScene" (
    delete apiSchemas = ["MjcSceneAPI", "NewtonXpbdSceneAPI"]
    prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI", "MjcSceneAPI"]
)
{
    uniform bool mjc:compiler:alignFree (
        displayName = "Align Free"
    )
    uniform token mjc:compiler:angle (
        displayName = "Angle"
    )
    uniform bool mjc:compiler:autoLimits (
        displayName = "Automatic Limits"
    )
    uniform bool mjc:compiler:balanceInertia (
        displayName = "Balance Inertia"
    )
    uniform double mjc:compiler:boundInertia (
        displayName = "Bound Inertia"
    )
    uniform double mjc:compiler:boundMass (
        displayName = "Bound Mass"
    )
    uniform bool mjc:compiler:fitAABB (
        displayName = "Fit AABB"
    )
    uniform bool mjc:compiler:fuseStatic (
        displayName = "Fuse Static"
    )
    uniform token mjc:compiler:inertiaFromGeom (
        displayName = "Inertia From Geom"
    )
    uniform int mjc:compiler:inertiaGroupRange:max (
        displayName = "Inertia Group Range Max"
    )
    uniform int mjc:compiler:inertiaGroupRange:min (
        displayName = "Inertia Group Range Min"
    )
    uniform bool mjc:compiler:saveInertial (
        displayName = "Save Inertial"
    )
    uniform double mjc:compiler:setTotalMass (
        displayName = "Set Total Mass"
    )
    uniform bool mjc:compiler:useThread (
        displayName = "Use Thread"
    )
    uniform bool mjc:flag:actuation (
        displayName = "Actuation Forces Toggle"
    )
    uniform bool mjc:flag:autoreset (
        displayName = "Automatic Simulation Reset Toggle"
    )
    uniform bool mjc:flag:clampctrl (
        displayName = "Control Input Clamping Toggle"
    )
    uniform bool mjc:flag:constraint (
        displayName = "Constraint Solver Toggle"
    )
    uniform bool mjc:flag:contact (
        displayName = "Contact Constraints and Collision Detection Toggle"
    )
    uniform bool mjc:flag:damper (
        displayName = "Damper Forces Toggle"
    )
    uniform bool mjc:flag:energy (
        displayName = "Energy Computation Toggle"
    )
    uniform bool mjc:flag:equality (
        displayName = "Equality Constraints Toggle"
    )
    uniform bool mjc:flag:eulerdamp (
        displayName = "Euler Integrator Damping Toggle"
    )
    uniform bool mjc:flag:filterparent (
        displayName = "Parent-Child Contact Filtering Toggle"
    )
    uniform bool mjc:flag:frictionloss (
        displayName = "Friction Loss Constraints Toggle"
    )
    uniform bool mjc:flag:fwdinv (
        displayName = "Forward/Inverse Dynamics Comparison Toggle"
    )
    uniform bool mjc:flag:gravity (
        displayName = "Gravity Toggle"
    )
    uniform bool mjc:flag:invdiscrete (
        displayName = "Discrete-Time Inverse Dynamics Toggle"
    )
    uniform bool mjc:flag:island (
        displayName = "Constraint Island Discovery Toggle"
    )
    uniform bool mjc:flag:limit (
        displayName = "Joint and Tendon Limit Constraints Toggle"
    )
    uniform bool mjc:flag:midphase (
        displayName = "Mid-Phase Collision Filtering Toggle"
    )
    uniform bool mjc:flag:multiccd (
        displayName = "Multiple Contact Collision Detection (CCD) Toggle"
    )
    uniform bool mjc:flag:nativeccd (
        displayName = "Native Convex Collision Detection Toggle"
    )
    uniform bool mjc:flag:override (
        displayName = "Contact Override Mechanism Toggle"
    )
    uniform bool mjc:flag:refsafe (
        displayName = "Solver Reference Safety Mechanism Toggle"
    )
    uniform bool mjc:flag:sensor (
        displayName = "Sensor Computations Toggle"
    )
    uniform bool mjc:flag:spring (
        displayName = "Spring Forces Toggle"
    )
    uniform bool mjc:flag:warmstart (
        displayName = "Solver Warm-Starting Toggle"
    )
    uniform int[] mjc:option:actuatorgroupdisable (
        displayName = "Actuator Group Disable"
    )
    uniform int mjc:option:ccd_iterations (
        displayName = "CCD Iterations"
    )
    uniform double mjc:option:ccd_tolerance (
        displayName = "CCD Tolerance"
    )
    uniform token mjc:option:cone = "elliptic" (
        displayName = "Friction Cone Type"
    )
    uniform double mjc:option:density (
        displayName = "Density"
    )
    uniform double mjc:option:impratio (
        displayName = "Impedance Ratio"
    )
    uniform token mjc:option:integrator = "implicit" (
        displayName = "Integrator"
    )
    uniform int mjc:option:iterations = 100 (
        displayName = "Solver Iterations"
    )
    uniform token mjc:option:jacobian (
        displayName = "Jacobian Type"
    )
    uniform int mjc:option:ls_iterations (
        displayName = "Linesearch Iterations"
    )
    uniform double mjc:option:ls_tolerance (
        displayName = "Linesearch Tolerance"
    )
    uniform double3 mjc:option:magnetic (
        displayName = "Magnetic Flux"
    )
    uniform int mjc:option:noslip_iterations (
        displayName = "Noslip Iterations"
    )
    uniform double mjc:option:noslip_tolerance (
        displayName = "Noslip Tolerance"
    )
    uniform double[] mjc:option:o_friction (
        displayName = "Contact Override Friction"
    )
    uniform double mjc:option:o_margin (
        displayName = "Contact Override Margin"
    )
    uniform double[] mjc:option:o_solimp (
        displayName = "Contact Override SolImp"
    )
    uniform double[] mjc:option:o_solref (
        displayName = "Contact Override SolRef"
    )
    uniform int mjc:option:sdf_initpoints (
        displayName = "SDF Initial Points"
    )
    uniform int mjc:option:sdf_iterations (
        displayName = "SDF Iterations"
    )
    uniform token mjc:option:solver (
        displayName = "Solver"
    )
    uniform double mjc:option:timestep (
        displayName = "Timestep"
    )
    uniform double mjc:option:tolerance (
        displayName = "Solver Tolerance"
    )
    uniform double mjc:option:viscosity (
        displayName = "Viscosity"
    )
    uniform double3 mjc:option:wind (
        displayName = "Wind Velocity"
    )
    bool newton:gravityEnabled (
        displayName = "Gravity Enabled"
    )
    uniform int newton:maxSolverIterations = 100 (
        displayName = "Max Solver Iterations"
    )
    uniform int newton:timeStepsPerSecond = 200 (
        displayName = "Time Steps Per Second"
    )
    uniform token physxScene:broadphaseType = "SAP"
    bool physxScene:enableCCD = 1
    bool physxScene:enableGPUDynamics = 0
}

def "Graph"
{
    def OmniGraph "ROS_GenericPub"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OnPlaybackTick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "GenericPublisher"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </Graph/ROS_GenericPub/Context.outputs:context>
            custom float inputs:data
            prepend float inputs:data.connect = </Graph/ROS_GenericPub/RTF.outputs:rtf>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Graph/ROS_GenericPub/OnPlaybackTick.outputs:tick>
            custom string inputs:messageName = "Float32"
            custom string inputs:messagePackage = "std_msgs"
            custom string inputs:messageSubfolder = "msg"
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom string inputs:topicName
            token node:type = "isaacsim.ros2.bridge.ROS2Publisher"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
        }

        def OmniGraphNode "RTF"
        {
            token node:type = "isaacsim.core.nodes.IsaacRealTimeFactor"
            int node:typeVersion = 1
            custom float outputs:rtf
        }

        def OmniGraphNode "Context"
        {
            custom uchar inputs:domain_id
            custom bool inputs:useDomainIDEnvVar
            token node:type = "isaacsim.ros2.bridge.ROS2Context"
            int node:typeVersion = 2
            custom uint64 outputs:context
        }
    }

}

