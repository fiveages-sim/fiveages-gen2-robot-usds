#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.0789450190300762, -4.0401114498805, 1.2896700255524065)
                double3 target = (-0.21734714814538103, 5.647581629733436, -0.0751058930786126)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./wuji_hand2_new.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = """Clean W2 + Wuji Hand2 grasp env.
Grid floor + EastRural table + apple/banana/bottle + YCB mug (handle) + SimReady lime (irregular).
Scene-level Newton/MuJoCo contact & PhysicsScene tune (robot assets untouched).
PhysX robot↔table mute (scene only; do not dual-group NonDexHand colliders):
1) EastRural_Table FilteredPairs → FiveAges_W2 for body/arms (already in W2
   NonDexHand; one group/collider).
2) World/CollisionGroups DexHand↔Table for Wuji_hand2 only — hands are excluded
   from NonDexHand and already author finger FilteredPairs, so hierarchy pairs
   from the table often miss them; they may safely join a Hands-only group.
Props stay out of Table group / filteredPairs → table↔props & robot↔props OK.
Right Hand2: Sensor=contact_force (Hand2 asset). Left: set Sensor=contact_force to enable.
Topics: /wuji_rh/* (RH), /wuji_lh/* (LH). See Hand2/payloads/Sensor/CONTACT_FORCE_README.md.
PhysX orchestration (this file, not wuji_hand2_newton.usda):
  newton.kit → open this usda → switch engine to PhysX
  → log must include Left_Arm and Wuji_hand2 in the physx variant switch
  → Play → motion-generation Reset env=yes (STOP→PLAY, same as other demos).
Spawn at x=-2 for nav. Joints match ocs2_wbc_controller.home_1 (USD degrees).
"""
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "default_environment" (
        prepend payload = @../../../../../../environment/fiveages_env/background/Grid/default_environment.usd@
    )
    {
        def "EastRural_Table" (
